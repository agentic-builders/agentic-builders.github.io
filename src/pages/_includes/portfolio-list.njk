<ul class="plist{% if show_portfolio_descriptions %} plist-detailed{% endif %}">{% for c in companies %}<li class="rv"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo | relativeUrl(page.url) }}" alt="" width="28" height="28" loading="lazy"><b>{{ c.name }}</b><span class="portfolio-summary">{{ c.for_humans }}</span>{% if show_portfolio_descriptions %}<p class="portfolio-description">{{ c.description }}</p>{% endif %}</a></li>{% endfor %}</ul>
<p class="fine portfolio-date">Last update: <time datetime="{{ fund.portfolio.updated }}">{{ fund.portfolio.updated | dateLabel }}</time></p>
