---
layout: home.njk
permalink: /investors/
mode: investors
pagecss: investors
title: "Agentic Builders for investors — thesis, program, team"
description: "Early-stage fund for agent-native products. Thesis, stage, four-week program, selection, team, selected portfolio, newsletter."
---
<main class="inv" id="main">
  <section class="inv-hero" id="top">
    <h1 class="rv">{{ fund.investors.hero }}</h1>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}">Contact us</a><a class="quiet" href="#newsletter">Newsletter</a></div>
    <ul class="nums rv" role="list">{% for n in fund.investors.numbers %}<li><b>{{ n.value }}</b><span>{{ n.label }}</span></li>{% endfor %}</ul>
  </section>

  <section id="approach">
    <h2 class="t rv">How we work.</h2>
    <dl class="approach">{% for a in fund.investors.approach %}<div class="rv"><dt>{{ a.name }}</dt><dd>{{ a.text }}</dd></div>{% endfor %}</dl>
  </section>

  <section id="team">
    <h2 class="t rv">Team.</h2>
    <ul class="team" role="list">{% for t in fund.team %}<li class="rv{% if t.agent %} agent{% endif %}"><span class="ph" aria-hidden="true">{% if t.agent %}<img src="{{ '/brand/icon-white.svg' | relativeUrl(page.url) }}" alt="" width="22" height="22">{% else %}{{ t.name | first }}{% endif %}</span><b>{{ t.name }}</b><span class="role">{{ t.role }}</span><p>{{ t.line }}</p>{% if t.agent %}<a class="pill pill-ghost sm" href="{{ '/apply/' | relativeUrl(page.url) }}">{{ t.cta }}</a>{% elif t.linkedin %}<a class="quiet" href="{{ t.linkedin }}" target="_blank" rel="noopener">LinkedIn →</a>{% endif %}</li>{% endfor %}</ul>
  </section>

  <section id="companies">
    <h2 class="t rv">Selected companies.</h2>
    <ul class="stickers rv" aria-label="Selected portfolio">{% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li style="--r:{{ (loop.index0 % 5) - 2 }}deg"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo | relativeUrl(page.url) }}" alt="" width="18" height="18"><span>{{ c.name }}</span></a></li>{% endfor %}</ul>
    <ul class="plist">{% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li class="rv"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo | relativeUrl(page.url) }}" alt="" width="28" height="28" loading="lazy"><b>{{ c.name }}</b><span>{{ c.for_humans }}</span></a></li>{% endfor %}</ul>
    <p class="fine rv"><a href="{{ '/#portfolio' | relativeUrl(page.url) }}">All {{ fund.portfolio.companies | length }} companies →</a></p>
  </section>

  <section id="newsletter">
    <h2 class="t rv">{{ fund.investors.newsletter.title }}.</h2>
    <p class="lead2 rv">{{ fund.investors.newsletter.text }}</p>
    {% if site.api_enabled %}<form class="subscribe rv" data-subscribe action="{{ site.api_base_url }}/subscribe" method="post">
        <label class="sr-only" for="sub-email-inv">Email</label>
        <input id="sub-email-inv" name="email" type="email" required autocomplete="email" placeholder="you@fund.com">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp">
        <button type="submit" class="pill pill-dark">Subscribe</button>
        <p class="sub-status" aria-live="polite"></p>
      </form>{% else %}<div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}?subject=Subscribe%20to%20the%20newsletter">Subscribe by email</a></div>{% endif %}
  </section>

  <section id="contact" class="last">
    <h2 class="t rv">{{ fund.investors.contact.title }}.</h2>
    <p class="lead2 rv">{{ fund.investors.contact.text }}</p>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}">{{ fund.fund.email }}</a><a class="quiet" href="{{ fund.fund.linkedin }}" target="_blank" rel="noopener">Agentic Builders on LinkedIn</a></div>
    <ul class="people rv" role="list">{% for t in fund.team %}{% if not t.agent %}<li>{{ t.name }}, {{ t.role | lower }}{% if t.linkedin %} · <a href="{{ t.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}</li>{% endif %}{% endfor %}</ul>
  </section>
</main>
