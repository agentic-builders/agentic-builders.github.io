{% set current = site.modes | selectattr("key", "equalto", mode) | first %}
<header class="site-header container">
    <a href="/" class="logo" aria-label="{{ fund.fund.name }} home">
        <img src="/brand/icon-color.svg" alt="" width="22" height="22">
        <span translate="no">{{ fund.fund.name }}</span>
    </a>

    <nav class="mode-switch" aria-label="Site mode">
        <ul role="list">
            {% for m in site.modes %}
            <li>
                <a href="{{ m.url }}" class="mode-link{% if m.key == mode %} is-active{% endif %}"{% if m.key == mode %} aria-current="page"{% endif %} data-mode-link>{{ m.label }}</a>
            </li>
            {% endfor %}
        </ul>
    </nav>

    {% if current.cta_key == "apply" %}
    <a class="btn" href="{{ fund.fund.apply_url }}" target="_blank" rel="noopener">{{ current.cta_label }}</a>
    {% elif current.cta_key == "agents_md" %}
    <a class="btn" href="/agents.md" download="agents.md">{{ current.cta_label }}</a>
    {% else %}
    <a class="btn" href="{% if fund.fund.meet_url | isTodo %}mailto:{{ fund.fund.email }}?subject=Meeting%20with%20Agentic%20Builders{% else %}{{ fund.fund.meet_url }}{% endif %}">{{ current.cta_label }}</a>
    {% endif %}
</header>
