<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title><meta name="description" content="{{ description }}"><meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Urbanist:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/hero.css">
<link rel="stylesheet" href="/assets/draft-{{ variant }}.css">
</head>
<body class="{{ variant }} page">
<nav class="nav"><a class="logo" href="/{{ variant }}/"><img src="/brand/icon-color.svg" alt="">Agentic Builders</a>
<div class="navlinks"><a href="#thesis">Thesis</a><a href="#mondays">Program</a><a href="#portfolio">Portfolio</a><a href="#faq">FAQ</a></div>
<a class="pill {{ navpill }}" href="{{ fund.fund.apply_url }}">Apply</a></nav>
{{ content | safe }}
<footer class="foot">
  <div class="foot-in">
    <span>&copy; 2026 Agentic Builders</span>
    <span><a href="/agents/">For agents</a> · <a href="/investors/">For investors</a> · <a href="/brand/">Brand</a> · <a href="{{ fund.fund.linkedin }}">LinkedIn</a> · <a href="mailto:{{ fund.fund.email }}">{{ fund.fund.email }}</a></span>
    <span>Ask about us: {% for e in site.ask_ai.engines %}<a href="{{ e.url }}{{ site.ask_ai.query | urlencode }}">{{ e.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
  </div>
</footer>
<div class="switch" aria-label="Drafts"><a href="/a/" class="{{ 'on' if variant == 'a' }}">Draft A</a><a href="/b/" class="{{ 'on' if variant == 'b' }}">Draft B</a></div>
<script src="/assets/draft.js" defer></script>
</body></html>
