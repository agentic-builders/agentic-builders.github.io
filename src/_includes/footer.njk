<footer class="site-footer container">
    <p class="footer-ask">
        Ask about us:
        {% for e in site.ask_ai.engines %}<a href="{{ e.url }}{{ site.ask_ai.query | urlencode }}" target="_blank" rel="noopener">{{ e.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </p>
    <nav class="footer-links" aria-label="Footer">
        {% for m in site.modes %}<a href="{{ m.url }}">{{ m.label }}</a>{% endfor %}
        <a href="/brand/">Brand</a>
        <a href="/agents.md">agents.md</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/agenticbuilders.vcf" download>vCard</a>
        <a href="{{ fund.fund.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:{{ fund.fund.email }}">{{ fund.fund.email }}</a>
    </nav>
    <p class="footer-meta">&copy; 2026 {{ fund.fund.name }} &middot; Last updated <time datetime="{{ fund.updated }}">{{ fund.updated }}</time></p>
</footer>
