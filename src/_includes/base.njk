<!DOCTYPE html>
<html lang="en" data-mode="{{ mode }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="canonical" href="{{ fund.fund.url }}{{ page.url }}">
    {% for m in site.modes %}<link rel="alternate" href="{{ fund.fund.url }}{{ m.url }}" title="{{ m.label }}">
    {% endfor %}
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ fund.fund.url }}{{ page.url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ fund.fund.url }}/og-image.png">
    <meta property="og:site_name" content="{{ fund.fund.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ fund.fund.url }}/og-image.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="alternate" type="text/markdown" href="/agents.md" title="agents.md">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% if mode == "agents" %}<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    {% else %}<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&family=Urbanist:wght@600;700;800&display=swap" rel="stylesheet">
    {% endif %}
    <link rel="stylesheet" href="/assets/draft.css">
    {% include "jsonld.njk" %}
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "header.njk" %}
    <main id="main" class="container">
        {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    <script src="/assets/site.js" defer></script>
</body>
</html>
