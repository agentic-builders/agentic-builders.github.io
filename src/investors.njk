---
layout: home.njk
permalink: /investors/
mode: investors
pagecss: investors
title: "Agentic Builders for investors — thesis, program, team"
description: "Early-stage fund for agent-native products. Thesis, stage, four-week program, selection, team, selected portfolio, pitch sessions."
---
<main class="inv" id="main">
  <section class="inv-hero" id="top">
    <h1 class="rv">{{ fund.investors.hero }}</h1>
    <div class="cta rv"><a class="pill pill-dark" href="#sessions">Pitch sessions</a><a class="quiet" href="#contact">Contact us</a></div>
    <ul class="nums rv" role="list">{% for n in fund.investors.numbers %}<li><b>{{ n.value }}</b><span>{{ n.label }}</span></li>{% endfor %}</ul>
  </section>

  <section id="approach">
    <h2 class="t rv">How we work.</h2>
    <dl class="approach">{% for a in fund.investors.approach %}<div class="rv"><dt>{{ a.name }}</dt><dd>{{ a.text }}</dd></div>{% endfor %}</dl>
  </section>

  <section id="team">
    <h2 class="t rv">Team.</h2>
    <ul class="team" role="list">{% for t in fund.team %}<li class="rv"><span class="ph" aria-hidden="true">{{ t.name | first }}</span><b>{{ t.name }}</b><span class="role">{{ t.role }}</span><p>{{ t.line }}</p>{% if t.linkedin %}<a class="quiet" href="{{ t.linkedin }}" target="_blank" rel="noopener">LinkedIn →</a>{% endif %}</li>{% endfor %}</ul>
    <p class="fine rv">The fund operates on its own AI agents: intake and deck analysis, weekly check-ins, memos, portfolio tracking. Partners decide; agents prepare.</p>
  </section>

  <section id="companies">
    <h2 class="t rv">Selected companies.</h2>
    <ul class="stickers rv" aria-label="Selected portfolio">{% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li style="--r:{{ (loop.index0 % 5) - 2 }}deg"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo }}" alt="" width="18" height="18"><span>{{ c.name }}</span></a></li>{% endfor %}</ul>
    <ul class="plist">{% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li class="rv"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo }}" alt="" width="28" height="28" loading="lazy"><b>{{ c.name }}</b><span>{{ c.for_humans }}</span></a></li>{% endfor %}</ul>
    <p class="fine rv"><a href="/#portfolio">All {{ fund.portfolio.companies | length }} companies →</a></p>
  </section>

  <section id="sessions">
    <h2 class="t rv">{{ fund.investors.pitch_sessions.title }}.</h2>
    <p class="lead2 rv">{{ fund.investors.pitch_sessions.text }}</p>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}?subject=Pitch%20session">{{ fund.investors.pitch_sessions.cta }}</a></div>
  </section>

  <section id="newsletter">
    <h2 class="t rv">{{ fund.investors.newsletter.title }}.</h2>
    <p class="lead2 rv">{{ fund.investors.newsletter.text }}</p>
    <div class="cta rv"><a class="pill pill-ghost" href="mailto:{{ fund.fund.email }}?subject=Subscribe">{{ fund.investors.newsletter.cta }}</a></div>
  </section>

  <section id="contact" class="last">
    <h2 class="t rv">{{ fund.investors.contact.title }}.</h2>
    <p class="lead2 rv">{{ fund.investors.contact.text }}</p>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}">{{ fund.fund.email }}</a><a class="quiet" href="{{ fund.fund.linkedin }}" target="_blank" rel="noopener">Agentic Builders on LinkedIn</a></div>
    <ul class="people rv" role="list">{% for t in fund.team %}<li>{{ t.name }}, {{ t.role | lower }}{% if t.linkedin %} · <a href="{{ t.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}</li>{% endfor %}</ul>
  </section>
</main>
