---
layout: home.njk
permalink: /investors/
mode: investors
pagecss: investors
title: "Agentic Builders for investors — thesis, program, team"
description: "Early-stage fund for agent-native products. Thesis, stage, four-week program, what we pay attention to, team, selected portfolio. Meet the cohort or meet us."
---
<main class="inv">
  <section class="inv-hero" id="top">
    <h1 class="rv">{{ fund.investors.hero }}</h1>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}?subject=Meeting%20with%20Agentic%20Builders">Meet us</a><a class="quiet" href="#sessions">Pitch sessions</a></div>
    <ul class="nums rv" role="list">
      {% for n in fund.investors.numbers %}<li><b>{{ n.value }}</b><span>{{ n.label }}</span></li>{% endfor %}
    </ul>
  </section>

  <section id="approach">
    <p class="t rv">How we work.</p>
    <dl class="approach">
      {% for a in fund.investors.approach %}<div class="rv"><dt>{{ a.name }}</dt><dd>{{ a.text }}</dd></div>{% endfor %}
    </dl>
  </section>

  <section id="team">
    <p class="t rv">Team.</p>
    <ul class="team" role="list">
      {% for t in fund.team %}<li class="rv{% if t.agent %} agent{% endif %}"><span class="ph" aria-hidden="true">{% if t.agent %}<img src="/brand/icon-white.svg" alt="">{% else %}{{ t.name | first }}{% endif %}</span><b>{{ t.name }}</b><span class="role">{{ t.role }}</span><p>{{ t.line }}</p>{% if t.agent %}<a class="pill pill-ghost sm" href="mailto:{{ fund.fund.email }}?subject=Subscribe">Want to know what it can do? Subscribe</a>{% endif %}</li>{% endfor %}
    </ul>
    <p class="fine rv">Photos and LinkedIn links: TODO.</p>
  </section>

  <section id="companies">
    <p class="t rv">Selected companies.</p>
    <ul class="stickers rv" aria-label="Selected portfolio">
      {% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li style="--r:{{ (loop.index0 % 5) - 2 }}deg"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo }}" alt="" loading="lazy"><span>{{ c.name }}</span></a></li>{% endfor %}
    </ul>
    <ul class="plist">
      {% for c in fund.portfolio.companies | byName(fund.investors.featured) %}<li class="rv"><a href="{{ c.url }}" target="_blank" rel="noopener"><img src="{{ c.logo }}" alt="" loading="lazy"><b>{{ c.name }}</b><span>{{ c.for_humans }}</span></a></li>{% endfor %}
    </ul>
    <p class="fine rv"><a href="/#portfolio">All {{ fund.portfolio.companies | length }} companies →</a></p>
  </section>

  <section id="sessions">
    <p class="t rv">{{ fund.investors.pitch_sessions.title }}.</p>
    <p class="lead2 rv">{{ fund.investors.pitch_sessions.text }}</p>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}?subject=Pitch%20session">{{ fund.investors.pitch_sessions.cta }}</a><span class="fine todo">{{ fund.investors.pitch_sessions.note }}</span></div>
  </section>

  <section id="newsletter">
    <p class="t rv">{{ fund.investors.newsletter.title }}.</p>
    <p class="lead2 rv">{{ fund.investors.newsletter.text }}</p>
    <div class="cta rv"><a class="pill pill-ghost" href="mailto:{{ fund.fund.email }}?subject=Subscribe">{{ fund.investors.newsletter.cta }}</a><span class="fine todo">TODO: sign-up link</span></div>
  </section>

  <section id="start" class="last">
    <p class="t rv">Meet us.</p>
    <p class="lead2 rv">A 30-minute call about the thesis, the program and co-investing.</p>
    <div class="cta rv"><a class="pill pill-dark" href="mailto:{{ fund.fund.email }}?subject=Meeting%20with%20Agentic%20Builders">Book a call</a><a class="quiet" href="mailto:{{ fund.fund.email }}">{{ fund.fund.email }}</a></div>
  </section>
</main>
